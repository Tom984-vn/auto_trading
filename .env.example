# DNSE LightSpeed API Configuration
DNSE_BASE_URL=https://services.dnse.com.vn
DNSE_WS_URL=wss://services.dnse.com.vn/ws
DNSE_USERNAME=your_dnse_username
DNSE_PASSWORD=your_dnse_password
DNSE_ACCOUNT_NO=0001XXXXXX
DNSE_LOAN_PACKAGE_ID=1531

# Telegram Bot Notifications & OTP Interactivity
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# Trading & Risk Rules Configuration
MAX_ORDER_VALUE=500000000  # Vốn tối đa 1 lệnh (VND) - ví dụ 500 triệu
MAX_DAILY_LOSS=50000000    # Hạn mức cắt lỗ tối đa trong ngày (VND) - ví dụ 50 triệu
ENABLE_LIVE_TRADING=false   # Set true khi chạy thực tế (chế độ an toàn mặc định false)
LOG_LEVEL=INFO
